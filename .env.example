# Meta Marketing API
META_API_VERSION=v25.0
META_LOG_TIMEZONE=Asia/Jakarta
META_AD_STATUS=aktif

# Sumber akun: excel atau api
# Default excel agar command lama tetap kompatibel.
META_ACCOUNT_SOURCE=excel

# Opsional: default periode laporan
# META_REPORT_PRESET=kemarin
# META_REPORT_SINCE=2026-08-01
# META_REPORT_UNTIL=2026-08-05

# Excel source
# META_ACCOUNT_SHEET=DAFTAR_AKUN

# API DATAMETA source
META_SOURCE_API_URL=https://api2nss.nusantara-sakti.co.id/ksapisvr
# Wajib jika META_ACCOUNT_SOURCE=api. Isi sendiri, jangan commit nilai produksi.
# META_SOURCE_API_NOHP=08xxxxxxxxxx
META_SOURCE_API_LAT=0.00
META_SOURCE_API_LON=0.00
META_SOURCE_API_JAM_MULAI=-10:00:00

# DATAMETA request compatibility/debug
META_SOURCE_API_BODY_MODE=auto

# CSV output delimiter: comma, tab, pipe, semicolon
META_CSV_DELIMITER=pipe

# Lokasi FILE LAPORAN utama: default, project, atau home
# home = ~/laporan
# _errors.csv, _info.csv, dan checkpoint default tetap di folder project.
META_OUTPUT_LOCATION=default
